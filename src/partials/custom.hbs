{{#if resume.custom.length}}
  <div class="container custom-container">
    {{#each resume.custom}}
      {{> title value=this.title}}
      {{#if items.length}}
        {{#each items}}
          <section class="item custom">
            {{> section-header name=this.name }}
            {{#if keywords_inline.length}}
              <p class="keywords-inline custom">{{{markdownToHtml (concatArr keywords_inline ", ")}}}</p>
            {{/if}}
            {{#if keywords.length}}
              <ul class="keywords custom">
                {{#each keywords}}
                  <li>{{{markdownToHtml this}}}</li>
                {{/each}}
              </ul>
            {{/if}}
          </section>
        {{/each}}
      {{/if}}
    {{/each}}
  </div>
{{/if}}
