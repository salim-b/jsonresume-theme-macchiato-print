{{#resume.basics}}
<div class="container about-container">
    {{> title value="About"}}

    {{#if location}}
        {{#location}}
        {{> info-tag text=(concatArr (toArray address (concatArr (toArray (concatArr (toArray countryCode postalCode) "-") city region) " ")) "<br>") icon="fa-map-marker"}}
        {{/location}}
    {{/if}}

    {{#if email}}
        {{> info-tag text=this.email icon="fa-envelope" isEmail=true url=this.email}}
    {{/if}}

    {{#if phone}}
        {{> info-tag text=this.phone icon="fa-mobile"}}
    {{/if}}

    {{#if website}}
        {{> info-tag text=this.website icon="fa-globe" url=this.website}}
    {{/if}}

    {{#if profiles}}
        {{#each profiles}}
            {{> social}}
        {{/each}}
    {{/if}}

    {{#if birth}}
        {{#birth}}
        {{#if date}}
            {{> info-tag text=date icon="fa-birthday-cake"}}
        {{/if}}
        {{/birth}}
    {{/if}}

    {{#if citizenship}}
        {{> info-tag text=this.citizenship icon="fa-flag"}}
    {{/if}}

    {{#if maritalStatus}}
        {{> info-tag text=this.maritalStatus icon="fa-circle-o-notch"}}
    {{/if}}
</section>
{{/resume.basics}}
